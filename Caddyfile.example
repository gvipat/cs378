# TLS for the gpu-lease API. Copy to /etc/caddy/Caddyfile.
#
#     sudo cp Caddyfile.example /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
#
# The name below is this deployment's; edit it only if you claimed a different
# one, and change API_URL in cli/gpulease.py to match if you do.
#
# Caddy gets a certificate from Let's Encrypt on first start, renews it on its
# own, and redirects http -> https. Nothing in gpulease knows this is here: the
# service binds to localhost and Caddy is the only thing that talks to it.
#
# Two things this needs that are easy to miss:
#
#   - A real DNS name, pointed at the lease host's Elastic IP. It cannot be the
#     EC2 public hostname: Let's Encrypt refuses to issue for
#     *.compute.amazonaws.com, so `ec2-1-2-3-4...` will fail the challenge. A
#     department subdomain or a cheap domain both work, and so does a free
#     duckdns.org name if you have neither -- see README -> "Put TLS in front".
#   - Ports 80 and 443 open to your students on the host's security group. 80
#     is not optional - it carries the ACME challenge and the redirect.
#
# Once this is up, port 8000 should NOT be reachable from outside the host.
# Keep GPULEASE_HOST=127.0.0.1 in gpulease.env and drop the old 8000 rule from
# the security group; a plaintext port still listening beside the TLS one is
# the whole problem, unmoved.

utcs378-infra.duckdns.org {
	reverse_proxy 127.0.0.1:8000
}

# The LiteLLM proxy (litellm/). DuckDNS answers for every name under ours, so
# this needs no DNS record of its own. Only the paths a student's client calls
# are forwarded: the admin API, the UI, and the provider pass-through routes
# all 404 here, so a leaked master key is useless from outside. Admin work goes
# over `ssh -L 4000:localhost:4000`. If a student's framework 404s on a path
# that is not admin, add it to @student.
llm.utcs378-infra.duckdns.org {
	@student path /v1/* /chat/completions /completions /embeddings /models /key/info /health/readiness
	handle @student {
		reverse_proxy 127.0.0.1:4000
	}
	respond 404
}

# gpu-lease configuration. Copy to gpulease.env and edit.
# systemd reads this verbatim, so: KEY=value, no `export`, no shell expansion.
# Restart after editing:  sudo systemctl restart gpulease

# --- identity -------------------------------------------------------------
# Every instance is tagged Course=<this>, and the service only ever touches
# instances carrying that tag. Two courses on one AWS account just need two
# different values here.
GPULEASE_COURSE=utcs378
GPULEASE_REGION=us-west-2

# --- serving --------------------------------------------------------------
# 127.0.0.1 assumes Caddy (or another TLS terminator) in front of this - see
# Caddyfile.example and README -> "Put TLS in front". Tokens and session SSH
# private keys both cross this connection, so do not expose it directly.
# Changing this needs `sudo ./setup.sh`, NOT just a restart: the bind address
# is baked into the systemd unit at install time.
GPULEASE_HOST=127.0.0.1
GPULEASE_PORT=8000
# Defaults to <repo>/var/gpulease.db
#GPULEASE_DB=/var/lib/gpulease/gpulease.db

# --- what students get ----------------------------------------------------
# Blank AMI = latest Ubuntu 22.04 LTS, which has NO NVIDIA DRIVER. That is fine
# for a t3 smoke test and useless on a GPU type: nvidia-smi is absent, so the
# boot script's GPU count comes back 0 and every student job fails. For
# g4dn.xlarge point this at an image with the driver already baked in. Two
# `amazon`-owned Ubuntu 22.04 images do that, and what separates them is how
# much CUDA rides along:
#   - Deep Learning Base AMI with Single CUDA - ONE toolkit, 35 GB snapshot.
#     The catch is that it pins the whole class to that one CUDA (13.2 as of
#     2026-09) with no /usr/local/cuda-12.x to fall back on. The T4 is sm_75,
#     which CUDA 13 still supports - it dropped Maxwell, Pascal and Volta, not
#     Turing.
#   - Deep Learning Base OSS Nvidia Driver GPU AMI - FOUR toolkits side by side
#     (12.6/12.8/12.9/13.0, default 12.9), 75 GB snapshot. Switch to this if an
#     assignment needs a 12.x toolchain or a cu12 torch wheel.
# The PyTorch DLAMI adds torch/NCCL on top of either. The command to look up
# current ids and root-volume sizes is in README -> "Things to know before this is student-facing".
#
# The AMI id is cached in-process, so restart the service after changing it.
GPULEASE_AMI=

# g4dn.xlarge: 1 x NVIDIA T4 (16 GB), 4 vCPU, 16 GiB RAM, ~$0.53/hour in
# us-west-2. Two things to check before this works:
#   - Service Quotas -> EC2 -> "Running On-Demand G and VT instances" is in
#     vCPUs, and this is 4 each: 20 groups x 2 nodes = 160. A fresh account has
#     zero and the request takes about a day.
#   - Inter-node bandwidth is shared ENA, not EFA (that starts at g4dn.8xlarge),
#     so a two-node all-reduce is network-bound. Correct, just not fast.
GPULEASE_INSTANCE_TYPE=g4dn.xlarge

# MUST be >= the root snapshot of GPULEASE_AMI - the launch passes VolumeSize
# explicitly, so a value under the AMI's own size fails every RunInstances with
# InvalidBlockDeviceMapping. As of 2026-09 the Ubuntu 22.04 single-CUDA image
# was 35 GB and the four-toolkit Base OSS one 75 GB; check yours and leave
# headroom for a dataset and torch.
#
# This is a running cost, not a standing one: the volume is destroyed with its
# instance when the session ends, so you pay for it only while a group is
# actually using it. At 20 groups x 2 nodes x 100 GB gp3 that is ~4 TB, about
# $0.44/hour with every group running at once and nothing at all overnight.
# (Under the old stop-don't-terminate design the same volumes stood at roughly
# $320/month whether or not anyone was using them.)
GPULEASE_ROOT_GB=100
# GPUs to expose per node, via CUDA_VISIBLE_DEVICES. (Older name:
# GPULEASE_GPUS_PER_GROUP, still read, same meaning.)
GPULEASE_GPUS_PER_NODE=1

# Instances per group per session. 2 is what the distributed-training
# assignment needs; 1 gives each group a single box.
#
# This MULTIPLIES YOUR BILL: a group burns this many instance-hours per
# wall-clock hour, and the worst-case arithmetic in README -> "What a session
# can cost you" gains a factor of it. Redo that sum before raising it.
#
# All of a group's nodes are launched into one subnet in a single RunInstances
# call, so they share an availability zone (cross-AZ traffic is billed per GB,
# and an all-reduce moves a lot of GB) and can reach each other on every port
# through a per-group security group. Max 8.
GPULEASE_NODES_PER_GROUP=2

# Rendezvous port exported to the nodes as MASTER_PORT. torch.distributed's
# default; change it only if something on your AMI already wants 29500.
GPULEASE_MASTER_PORT=29500

# Blank = every public subnet in the default VPC (tried in order on capacity
# errors). With more than one node per group, capacity for the WHOLE set has to
# exist in one of them - EC2 places all of a group's nodes or none.
GPULEASE_SUBNET_IDS=
# Narrow this to campus ranges when you can. The control-plane host adds its
# own IP automatically, since it polls port 22 to detect readiness.
GPULEASE_ALLOWED_SSH_CIDRS=0.0.0.0/0

# --- policy ---------------------------------------------------------------
# Bump the assignment between homeworks; limits are per (group, assignment).
GPULEASE_ACTIVE_ASSIGNMENT=hw1

# Hard cutoff for the active assignment. ISO 8601 - WRITE THE UTC OFFSET, a
# bare timestamp is read as UTC and your syllabus almost certainly is not.
# Once it passes: no group may start, and the reaper destroys everything tagged
# for this course on its next pass. Leases are also capped so none can outlive
# it, so a group starting an hour before the cutoff gets a one-hour lease.
# Blank = no deadline. A malformed value stops the service at boot on purpose.
#
# Deliberately BLANK here. setup.sh copies this file to gpulease.env when there
# is none and then starts the service on it, so anything filled in here is live
# on first boot -- and a wrong date is a date on which every group's session
# ends and cannot be restarted. Stamp your real cutoff at deploy time, once,
# after checking the offset.
GPULEASE_DEADLINE=

# How many times a group may start a session for one assignment.
#   0 = unlimited, the default and the sane setting. Sessions are disposable:
#       stopping destroys the nodes, starting builds new ones, and what a group
#       can spend is bounded by GPULEASE_GPU_HOUR_QUOTA below.
#   1 = one lease per group. Once it ends - whether they stopped it or the
#       lease expired - they cannot start again, and `admin.py grant <group>`
#       is the only way back in. Rarely what you want now.
GPULEASE_MAX_STARTS=0

# The bound on any single session. There is no idle watchdog: an instance a
# group started runs until they stop it or this expires, busy or not, so this
# is what caps one forgotten session at
#
#     NODES_PER_GROUP x MAX_SESSION_HOURS x instance $/hour
#
# 0 means no cap, leaving GPU_HOUR_QUOTA below as the only bound: a session then
# runs until the group's budget is spent. That is a reasonable setting with
# unlimited starts -- a group whose lease expires simply starts another one, and
# nodes are disposable either way -- but it does mean one Friday session nobody
# stopped can burn a group's entire allowance over a weekend.
GPULEASE_MAX_SESSION_HOURS=8

# THE budget, and the only thing rationing anything. Cumulative GPU-hours a
# group may spend across all its sessions on one assignment, counted as
# node-hours: a two-node session spends two per wall-clock hour. Charged when a
# session stops; checked when one starts, which also caps that session's lease
# at whatever is left. So MAX_SESSION_HOURS above bounds any single session and
# this bounds the assignment:
#
#     groups x GPU_HOUR_QUOTA x instance $/hour
#
# is what the class can cost you, and it is the number to pick this against.
# There is no NODES_PER_GROUP in that sum: the quota is already counted in
# node-hours, so a second node makes a group spend it twice as fast rather than
# letting them spend twice as much.
GPULEASE_GPU_HOUR_QUOTA=60

# The smallest lease worth handing out, in minutes. A group with less budget
# left than this is told they are out rather than given a cluster that expires
# before it has finished booting.
GPULEASE_MIN_START_MINUTES=15

# There is nothing here about reclaiming disks, and nothing to schedule at the
# end of an assignment. Instances are ephemeral: a session's nodes are
# destroyed when it ends, by any route, and their root volumes go with them.
# Nothing accumulates between sessions. GPULEASE_TERMINATE_AT_DEADLINE and
# GPULEASE_TERMINATE_GRACE_HOURS no longer exist; delete them if an older
# gpulease.env still carries them.

# --- reaper ---------------------------------------------------------------
GPULEASE_REAPER=1
GPULEASE_REAPER_INTERVAL=120

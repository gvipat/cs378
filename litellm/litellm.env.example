# Template only. setup.sh writes litellm/litellm.env (mode 600) with fresh
# random values the first time it runs and never touches it again: replacing
# LITELLM_SALT_KEY makes everything LiteLLM has encrypted in the database
# unreadable. Keep litellm.env out of git.

# Admin credential for the proxy. Never give it to students; use it only over
# the SSH tunnel (ssh -L 4000:localhost:4000 ...).
LITELLM_MASTER_KEY=sk-REPLACE
LITELLM_SALT_KEY=sk-REPLACE

# Local Postgres, created by setup.sh.
DATABASE_URL=postgresql://litellm:REPLACE@127.0.0.1:5432/litellm

# Use the prices in config.yaml and the bundled cost map; do not fetch one from
# GitHub at startup.
LITELLM_LOCAL_MODEL_COST_MAP=True
